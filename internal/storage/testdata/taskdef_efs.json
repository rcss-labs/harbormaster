{
  "taskDefinitionArn": "arn:aws:ecs:us-east-1:111111111111:task-definition/report-worker:31",
  "family": "report-worker",
  "revision": 31,
  "networkMode": "awsvpc",
  "requiresAttributes": [{"name": "com.amazonaws.ecs.capability.docker-remote-api.1.25"}],
  "compatibilities": ["EC2", "FARGATE"],
  "containerDefinitions": [
    {
      "name": "report-worker",
      "image": "111111111111.dkr.ecr.us-east-1.amazonaws.com/report-worker:5.0.1",
      "essential": true,
      "portMappings": [],
      "environment": [{"name": "REPORT_DIR", "value": "/data/reports"}],
      "mountPoints": [{"sourceVolume": "reports-data", "containerPath": "/data/reports", "readOnly": false}],
      "futureField": {"nested": true}
    }
  ],
  "volumes": [
    {
      "name": "reports-data",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-02e7d1c9",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {"accessPointId": "fsap-07f3e9a1c2", "iam": "ENABLED"}
      }
    }
  ],
  "status": "ACTIVE",
  "cpu": "1024",
  "memory": "2048",
  "registeredBy": "terraform (TerraDuckTel)"
}
