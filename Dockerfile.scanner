# Harbormaster scanner image: verified Syft and Grype + the harbormaster-scanner binary on distroless nonroot.
# Build: make scanner-image VERSION=<version> [ARCH=amd64|arm64]  (default amd64, matching the module's cpu_architecture)
# The fetch and go-build stages run on the build host's native platform, so building for another architecture
# needs no emulation. Syft and Grype are downloaded for the target architecture and verified with cosign and
# their signed checksums by tools/scanner-verify.sh; a failed verification fails the build.

# ghcr.io/sigstore/cosign/cosign:v2.6.5 (verifier only; never in the final image)
FROM --platform=$BUILDPLATFORM ghcr.io/sigstore/cosign/cosign:v2.6.5@sha256:ad281047f85c5e1fc6ffbc30c2b55be3b07b4032bef715a12122ce5829619aca AS cosign

# golang:1.27.3-alpine3.24
FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS fetch
ARG TARGETARCH
ARG SYFT_VERSION=1.57.0
ARG GRYPE_VERSION=0.121.2
# sha256 of <project>_<version>_checksums.txt, pinned in addition to its signature.
ARG SYFT_CHECKSUMS_SHA256=bec8ee399df0b23cb7b6fe7b72f290418bdbf91cab2e01bfa0a44f2a2e96d006
ARG GRYPE_CHECKSUMS_SHA256=031a06d6c9184a3a0b379f1544938bdf8ecc18327aa2e46ea912bbf6ce51fc65
# Exact SAN of the release workflow's certificate, read from the signed bundle. Anchore's release workflow
# runs from main, hence refs/heads/main rather than the tag.
ARG SYFT_IDENTITY=https://github.com/anchore/syft/.github/workflows/release.yaml@refs/heads/main
ARG GRYPE_IDENTITY=https://github.com/anchore/grype/.github/workflows/release.yaml@refs/heads/main
# busybox has no `file`; scanner-verify.sh needs it to confirm the binaries are static.
RUN apk add --no-cache file=5.47-r2
COPY --from=cosign /ko-app/cosign /usr/local/bin/cosign
COPY tools/scanner-verify.sh /usr/local/bin/scanner-verify.sh
RUN set -eu; \
    scanner-verify.sh syft "${SYFT_VERSION}" "${SYFT_CHECKSUMS_SHA256}" "${SYFT_IDENTITY}" "${TARGETARCH}" /out/bin; \
    scanner-verify.sh grype "${GRYPE_VERSION}" "${GRYPE_CHECKSUMS_SHA256}" "${GRYPE_IDENTITY}" "${TARGETARCH}" /out/bin; \
    mkdir /out/work

# golang:1.27.3-alpine3.24
FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine3.24@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS go-build
ARG VERSION=dev
ARG COMMIT=none
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
    -o /out/harbormaster-scanner ./cmd/harbormaster-scanner

# gcr.io/distroless/static-debian12:nonroot (no versioned tags; pinned by digest)
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=go-build /out/harbormaster-scanner /harbormaster-scanner
COPY --from=fetch /out/bin/syft /usr/local/bin/syft
COPY --from=fetch /out/bin/grype /usr/local/bin/grype
# 65532 is distroless nonroot. A volume mounted on /work (Fargate) is writable by the non-root user because
# the mount point carries this ownership; a bare `docker run --tmpfs /work` is writable too.
COPY --from=fetch --chown=65532:65532 /out/work /work
USER nonroot:nonroot
ENV HM_SCAN_WORK_DIR=/work \
    TMPDIR=/work/tmp \
    SYFT_CACHE_DIR=/work/syft \
    GRYPE_DB_CACHE_DIR=/work/grype \
    XDG_CACHE_HOME=/work/cache
VOLUME /work
# Exec form: the image has no shell.
HEALTHCHECK --interval=30s --timeout=5s CMD ["/harbormaster-scanner", "healthcheck"]
ENTRYPOINT ["/harbormaster-scanner"]
CMD ["run"]
